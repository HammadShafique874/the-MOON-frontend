# Backend ORIGIN only (the /api/v1 prefix is added by the app), e.g. http://localhost:8000
# A trailing /api or /api/v1 is tolerated and stripped.
VITE_API_BASE_URL=
# true = in-browser mock backend (default). Set to false to call the real API.
VITE_USE_MOCK_DATA=true

# VITE_API_TIMEOUT_MS=15000
# VITE_MOCK_LATENCY_MS=250
# VITE_ENABLE_VISION=false
